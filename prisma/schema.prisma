// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

model TemplateCustomization {
  id           String   @id @default(cuid())
  shop         String
  documentType String
  templateId   String
  settings     Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([shop, documentType, templateId])
  @@index([shop])
}

model ShopSettings {
  id                 String   @id @default(cuid())
  shop               String   @unique
  storeDetails       Json
  smtpSettings       Json     @default("{}")
  selectedTemplates  Json     @default("{}")
  numberSeries       Json     @default("{}")
  numberBackfillUndo Json?
  /// Set when existing Shopify orders were numbered on install / first sync.
  salesOrderNumbersSyncedAt DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SalesOrderNumberCounter {
  id         String   @id @default(cuid())
  shop       String
  templateId String
  nextValue  Int
  prefix     String
  padLength  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([shop, templateId])
  @@index([shop])
}

model SalesOrderDocumentNumber {
  id             String    @id @default(cuid())
  shop           String
  templateId     String
  orderGid       String
  sequence       Int
  documentNumber String
  documentDate   DateTime?
  customerNote   String?
  terms          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([shop, templateId, orderGid])
  @@unique([shop, templateId, sequence])
  @@index([shop, templateId])
}

model OrderInvoiceStatus {
  id             String   @id @default(cuid())
  shop           String
  orderGid       String
  invoicedAt     DateTime @default(now())
  sequence       Int?
  documentNumber String?
  customerNote   String?
  terms          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([shop, orderGid])
  @@unique([shop, sequence])
  @@unique([shop, documentNumber])
  @@index([shop])
}

model OrderPackingSlipStatus {
  id          String   @id @default(cuid())
  shop        String
  orderGid    String
  convertedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shop, orderGid])
  @@index([shop])
}

model OrderCreditNoteStatus {
  id             String    @id @default(cuid())
  shop           String
  orderGid       String
  convertedAt    DateTime  @default(now())
  sequence       Int?
  documentNumber String?
  /** Merchant reason for issuing the credit note. */
  reason         String?
  customerNote   String?
  terms          String?
  /** Deprecated — unused; kept for existing DBs. */
  creditAmount   String?
  voidedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([shop, orderGid])
  @@unique([shop, sequence])
  @@unique([shop, documentNumber])
  @@index([shop])
}
